<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/demo_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:colorBackground"
    android:clipChildren="false"
    android:clipToPadding="false">

    <ScrollView
        android:id="@+id/backdrop"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="?android:colorBackground"
        android:clipToPadding="false"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/demo_content"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="22dp"
            android:paddingTop="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="serif"
                android:text="@string/app_name"
                android:textColor="?android:textColorPrimary"
                android:textSize="38sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="5dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/current_tab"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:accessibilityLiveRegion="polite"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textColor="?android:textColorSecondary"
                    android:textSize="15sp" />

                <Button
                    android:id="@+id/play_animation"
                    style="?android:attr/borderlessButtonStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_demo_play"
                    android:minHeight="48dp"
                    android:paddingHorizontal="14dp"
                    android:text="@string/play_animation"
                    android:textAllCaps="false"
                    android:textColor="?android:textColorPrimary"
                    android:textSize="14sp" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <io.github.bohaofu.glasscapsulenav.GlassNavBar
        android:id="@+id/glass_bar"
        style="@style/Widget.GlassCapsuleNav.Bar"
        android:layout_gravity="bottom"
        android:layout_marginHorizontal="13dp"
        android:layout_marginBottom="24dp">

        <LinearLayout
            android:id="@id/glass_nav_tabs"
            style="@style/Widget.GlassCapsuleNav.Row">

            <io.github.bohaofu.glasscapsulenav.GlassNavTab
                android:id="@+id/tab_home"
                style="@style/Widget.GlassCapsuleNav.Tab"
                app:glassNavIcon="home"
                app:glassNavLabel="@string/home" />

            <io.github.bohaofu.glasscapsulenav.GlassNavTab
                android:id="@+id/tab_messages"
                style="@style/Widget.GlassCapsuleNav.Tab"
                app:glassNavIcon="message"
                app:glassNavLabel="@string/messages" />

            <io.github.bohaofu.glasscapsulenav.GlassNavTab
                android:id="@+id/tab_notifications"
                style="@style/Widget.GlassCapsuleNav.Tab"
                app:glassNavIcon="notification"
                app:glassNavLabel="@string/notifications" />

            <io.github.bohaofu.glasscapsulenav.GlassNavTab
                android:id="@+id/tab_profile"
                style="@style/Widget.GlassCapsuleNav.Tab"
                app:glassNavIcon="profile"
                app:glassNavDrawable="@drawable/ic_demo_avatar"
                app:glassNavLabel="@string/profile" />
        </LinearLayout>
    </io.github.bohaofu.glasscapsulenav.GlassNavBar>
</FrameLayout>
